// RepoReview Arena — architecture as code (LikeC4)
// Last checked against src/reporeview_arena at commit eb5bf75 (package version 0.1.0).
// Elements and relationships reflect the current implementation, including the managed
// per-user review history and the Control Page workflow.
// Validate:  node <worca>/scripts/c4-check-cli.mjs docs/architecture/architecture.c4

specification {

  color arenaTeal #1f7a78
  color violet #6353b8

  element actor {
    style {
      shape person
      color slate
    }
  }
  element system {
    style {
      color blue
    }
  }
  element client {
    style {
      shape browser
      color violet
    }
  }
  element process {
    style {
      color indigo
    }
  }
  element module {
    style {
      color arenaTeal
    }
  }
  element library {
    style {
      color violet
    }
  }
  element store {
    style {
      shape storage
      color amber
    }
  }
  element artifact {
    style {
      color amber
    }
  }
  element external {
    style {
      color slate
    }
  }

  relationship spawns {
    color indigo
    line solid
  }
  relationship reads {
    color slate
    line dashed
  }
  relationship writes {
    color amber
    line solid
  }

  // boundary  = code that enforces a trust or safety limit (loopback gate, read-only tools, snapshot denylist)
  // manual    = a step a human performs outside the application
  // optional  = only present when the llm extra is installed or the operator opts in
  // example   = a route taken from models.example.json; the code itself is provider-agnostic
  tag boundary
  tag manual
  tag optional
  tag example

  deploymentNode layer
  deploymentNode frame
}

model {

  // ───────────────────────── People and outside tools ─────────────────────────

  reviewer = actor 'Reviewer' {
    description 'The one human in the loop. Creates the arena, confirms that source fragments may leave the machine, runs audits, then confirms or rejects every finding: nothing scores until they do.'
  }

  codingAgent = external 'IDE or coding agent' {
    #manual
    #optional
    description 'Option B in the README: VS Code or any agent with wider tools, given the same prompt by hand. Its only link to Arena is a JSON report that the reviewer imports; the code never calls it.'
    technology 'Outside this repository'
  }

  git = external 'git CLI' {
    description 'The reporeview process shells out to it, with a 15 second timeout per call, to find the repository root, check for tracked-file changes, read HEAD and list tracked files. No checkout, fetch or clone.'
    technology 'git rev-parse · git diff --name-only HEAD · git ls-files -z'
  }

  providers = external 'LLM provider endpoints' {
    description 'Whatever LiteLLM routes a provider/model id to. models.example.json lists six example routes; any LiteLLM route, including one pinned with api_base, works the same way. Arena sees only the completion object that comes back.'

    openai = external 'OpenAI' {
      #example
      description 'Example route openai/… (contestant id gpt).'
    }
    anthropic = external 'Anthropic' {
      #example
      description 'Example route anthropic/… (contestant id claude).'
    }
    gemini = external 'Google Gemini' {
      #example
      description 'Example route gemini/… (contestant id gemini).'
    }
    mistral = external 'Mistral' {
      #example
      description 'Example route mistral/… (contestant id mistral).'
    }
    xai = external 'xAI' {
      #example
      description 'Example route xai/… (contestant id grok).'
    }
    openrouter = external 'OpenRouter' {
      #example
      description 'Example route openrouter/… for four contestants (glm, qwen, kimi, mimo). Free endpoints are the case the retry and Retry-After handling was written for.'
    }
    custom = external 'Custom api_base endpoint' {
      description 'Any compatible server named by the api_base field of a models.json entry; passed straight through to LiteLLM.'
      technology 'models.json api_base'
    }
  }

  // ───────────────────────── Files that live outside the arena folder ─────────────────────────

  targetRepo = store 'Target Git checkout' {
    description 'The clean local checkout being audited. Arena runs git against it and reads tracked files, and never writes to it. Untracked files are ignored; modified tracked files make init fail.'
    technology 'Any local Git working tree'
  }

  modelsConfig = store 'models.json' {
    description 'Operator-written contestant list: id, LiteLLM model name, optional api_base, max_tokens and enabled. Gitignored, copied from models.example.json, never holds keys. The CLI reads it at run time; the dashboard re-reads it on every status poll and run request.'
    technology 'models.json (see models.example.json)'
  }

  apiKeys = store 'Provider API keys' {
    description 'Environment variables of the local reporeview process (OPENAI_API_KEY, ANTHROPIC_API_KEY, … see .env.example). Arena code never reads, stores or logs them: the only mention in src/ is an error message. LiteLLM picks them up from the environment.'
    technology 'Process environment'
  }

  // ───────────────────────────── RepoReview Arena ─────────────────────────────

  arena = system 'RepoReview Arena' {
    description 'Freezes one Git commit, gives every contestant model the same audit prompt and three read-only tools, validates reports, and ranks contestants on human-confirmed findings. Local only: no hosted component or database; dashboard audit jobs run in one in-memory worker.'
    technology 'Python 3.11+ · src/reporeview_arena · no runtime dependencies (litellm is an optional extra)'

    // ── Client ──

    page = client 'Dashboard page' {
      description 'One HTML page with inline CSS and JavaScript, built as a Python string and served by the dashboard server. English and Brazilian Portuguese, no build step. Provides a five-step repository-to-results workflow, lets each review select code audit, Golden Feature or both, displays independent scoreboards, saves the language choice in localStorage, and polls while a provider job is queued or running.'
      technology 'src/reporeview_arena/app.py (PAGE)'
    }

    // ── The process ──

    proc = process 'reporeview process' {
      description 'One OS process per invocation. reporeview web keeps it alive as a loopback HTTP server; init, run, import, judge, rubric, score and prompt run once and exit. The Control Page persists its selected repository and managed reviews in the OS application-data directory; active workspace and job state live in memory.'
      technology 'Python console script reporeview = reporeview_arena.cli:main'

      cli = module 'CLI' {
        description 'argparse front end for init, run, import, web, score, prompt, judge and rubric. Requires --confirm-send-code before any provider call and refuses to overwrite an existing report. Reaches into app.py for serve() and the private _data().'
        technology 'src/reporeview_arena/cli.py'
      }
      server = module 'Dashboard server' {
        #boundary
        description 'Stdlib ThreadingHTTPServer on 127.0.0.1. Requires the exact Host header; POST requests also require the per-process X-Arena-Token and a same-origin Origin when supplied. Serves the page, folder picker and JSON API for repository selection, review history, workspace setup, audits, imports and adjudication.'
        technology 'src/reporeview_arena/app.py (create_server, Handler)'
      }
      jobs = module 'Audit job runner' {
        description 'Runs one audit job on a daemon thread with its own asyncio loop. Only one job may be queued or running; starting another job clears prior job records. Job state is in memory and is lost on restart.'
        technology 'src/reporeview_arena/app.py (_start_audit)'
      }
      orchestrator = module 'Orchestrator' {
        #boundary
        description 'One independent tool-use conversation per contestant, bounded by a concurrency semaphore (1 to 16), a step budget (at most 200) and a 250 kB context window that drops the oldest tool rounds. Dispatches exactly three tools and answers any other name with ERROR: unknown tool. Classifies provider failures, retries transient ones with exponential backoff and honours Retry-After up to 60 s.'
        technology 'src/reporeview_arena/orchestrator.py (audit_many, audit_one)'
      }
      reader = module 'Read-only repository reader' {
        #boundary
        description 'The only thing a model can touch: list_files, read_file and search_code over the frozen snapshot. Bounded (250 names, 240 lines, 150 matches per call), no shell, no network, no writes, symlinks skipped, paths checked against an allow-list built at construction.'
        technology 'src/reporeview_arena/repository.py (RepositoryReader)'
      }
      snapshotter = module 'Snapshot builder' {
        #boundary
        description 'Freezes a clean checkout: rejects a non-root path or modified tracked files, then copies each tracked UTF-8 text file that passes a name and extension denylist and the size limits (180 kB per file, 16 MB total). A denylist, not secret detection.'
        technology 'src/reporeview_arena/repository.py (snapshot_repo)'
      }
      workspaceBuilder = module 'Workspace builder' {
        description 'initialize_workspace(): snapshot, manifest.json and prompt.md in one step. Persists selected review_modes; creates CLI workspaces with both modes by default; includes audit focus or Golden Feature directions only for selected modes.'
        technology 'src/reporeview_arena/workspace.py'
      }
      promptBuilder = module 'Prompt builder' {
        description 'Builds one mode-specific prompt per review with repository metadata and file tree. When both modes are selected, code audit and Golden Feature instructions and JSON fields are separate in the same prompt.'
        technology 'src/reporeview_arena/prompts.py (build_prompt)'
      }
      reportValidator = module 'Report validator' {
        #boundary
        description 'Accepts raw JSON or a fenced json block and validates only the report sections selected by the workspace review_modes; checks finding fields and source citations when code audit is active, and requires a named golden_feature when that mode is active.'
        technology 'src/reporeview_arena/reports.py (parse_report, validate_locations)'
      }
      scorer = module 'Scorer' {
        description 'Computes the combined score and separate Control Page leaderboards: code audit uses confirmed findings (up to 60) and improvements /20 with false-positive penalties; Golden Feature uses its human score /20.'
        technology 'src/reporeview_arena/scoring.py (calculate, leaderboard, leaderboards)'
      }
      storage = module 'JSON storage' {
        description 'load_json and save_json. save_json writes a temp file beside the target and os.replace()s it, so a crash never leaves a half-written report. workspace_file() would reject paths that escape the workspace but nothing calls it.'
        technology 'src/reporeview_arena/storage.py'
      }
      localData = module 'Per-user data manager' {
        description 'Chooses the OS-standard application-data directory, persists the selected repository path, lists reviews for that checkout and validates managed review IDs and paths.'
        technology 'src/reporeview_arena/local_data.py'
      }
      litellm = library 'LiteLLM SDK' {
        #optional
        description 'Imported lazily inside audit_one() so a plain install works for manual review. Normalises every provider behind one acompletion() call with tool support. Arena turns its own retries off (num_retries 0, max_retries 0) and does the retrying itself.'
        technology 'litellm>=1.70,<2 (pip install -e .[llm])'
      }
    }

    // ── Data the application owns ──

    appData = store 'Per-user application data' {
      description 'OS-standard local storage used by the Control Page. Stores the selected repository and managed review workspaces; separate from CLI workspaces created at operator-chosen paths.'
      technology 'Filesystem - app_data_directory()'

      settings = artifact 'settings.json' {
        description 'The absolute path of the selected repository root, or null. No model credentials are stored here.'
        technology 'app data directory/settings.json'
      }
      reviews = artifact 'reviews/<id>/' {
        description 'One UUID-named review workspace per Control Page review. Each contains the manifest, prompt, frozen snapshot, reports, judgments and failures; reviews are filtered by repository path.'
        technology 'app data directory/reviews/<uuid>/'
      }
    }

    workspace = store 'Arena workspace folder' {
      description 'One folder per audit, created by CLI init or the Control Page and never nested in the target repo. Plain JSON and text files are the audit record.'
      technology 'Filesystem · path given to --out and --workspace'

      manifest = artifact 'manifest.json' {
        description 'Repo name, original path, commit SHA, detected languages, selected review_modes, every kept file with byte count and SHA-256, and every skipped file with its reason. Legacy manifests without review_modes are treated as both.'
        technology 'workspace/manifest.json'
      }
      prompt = artifact 'prompt.md' {
        description 'The selected review prompt every contestant receives. Includes only active deliverables and is read by audit_one(), reporeview prompt and GET /api/prompt.'
        technology 'workspace/prompt.md'
      }
      snapshot = artifact 'snapshot/' {
        description 'Frozen, denylist-filtered copy of the tracked source at one commit. The only tree a model can read.'
        technology 'workspace/snapshot/'
      }
      reports = artifact 'reports/' {
        description 'One validated report per contestant, with only mode-required sections (findings, hotpath, improvements, golden_feature) and audit_metadata. Every entry point refuses to overwrite an existing id.'
        technology 'workspace/reports/<model-id>.json'
      }
      judgments = artifact 'judgments/' {
        description 'Human verdict, severity, issue key and fabricated-evidence flag per finding, plus the improvements and gold rubric. Rewritten in place by judge, rubric and the dashboard.'
        technology 'workspace/judgments/<model-id>.json'
      }
      failures = artifact 'failures/' {
        description 'Raw response, validation error, finish reason and token usage of a rejected report. The latest rejection replaces the previous one for that model; nothing here is ever scored.'
        technology 'workspace/failures/<model-id>.json'
      }
    }
  }

  // ───────────────────────────── Relationships ─────────────────────────────

  // People
  reviewer -> arena.proc.cli 'runs init, run, import, judge, rubric, score, prompt, web'
  reviewer -> arena.page 'opens http://127.0.0.1:8765 to select a repository, create or open a review, run audits and adjudicate'
  reviewer -> codingAgent 'runs the shared prompt by hand (Option B)'

  // Dashboard page
  arena.page -> arena.proc.server 'loopback JSON API: GET /api/status, /api/reviews, /api/data, /api/prompt, /api/jobs/<id>; POST /api/settings/repository, /api/reviews, /api/reviews/open, /api/folders, /api/workspace/open, /api/workspace/init, /api/run, /api/import, /api/adjudicate, /api/rubric'

  // CLI
  arena.proc.cli -> arena.proc.workspaceBuilder 'init: initialize_workspace()'
  arena.proc.cli -> arena.proc.orchestrator 'run: asyncio.run(audit_many())'
  arena.proc.cli -> arena.proc.server 'web: serve()'
  arena.proc.cli -> arena.proc.server 'score, judge, rubric: _data() for reports, judgments and leaderboard'
  arena.proc.cli -> arena.proc.reportValidator 'import: parse_report() then validate_locations()'
  arena.proc.cli -> arena.proc.storage 'load_json, save_json'
  arena.proc.cli -[reads]-> modelsConfig 'run: enabled models, each checked with model_slug()'
  arena.proc.cli -[reads]-> arena.workspace.prompt 'prompt: prints prompt.md'
  arena.proc.cli -[writes]-> arena.workspace.reports 'import: reports/<model>.json'
  arena.proc.cli -[writes]-> arena.workspace.judgments 'judge and rubric'

  // Dashboard server
  arena.proc.server -> arena.proc.jobs 'POST /api/run: _start_audit()'
  arena.proc.server -> arena.proc.localData 'load settings, save repository selection, list and resolve managed reviews'
  arena.proc.server -> arena.proc.workspaceBuilder 'POST /api/reviews creates a managed review; /api/workspace/init creates a chosen-path workspace; validate_workspace()'
  arena.proc.server -> arena.proc.reportValidator 'POST /api/import: parse_report() then validate_locations()'
  arena.proc.server -> arena.proc.scorer 'GET /api/data and /api/status: combined leaderboard() plus mode-specific leaderboards()'
  arena.proc.server -> arena.proc.storage 'load_json, save_json'
  arena.proc.server -[reads]-> modelsConfig 'lists enabled ids only; model names never reach the browser'
  arena.proc.server -[reads]-> arena.workspace.reports 'GET /api/data'
  arena.proc.server -[reads]-> arena.workspace.judgments 'GET /api/data'
  arena.proc.server -[reads]-> arena.workspace.manifest 'GET /api/data, approved file list for import'
  arena.proc.server -[reads]-> arena.workspace.prompt 'GET /api/prompt'
  arena.proc.server -[writes]-> arena.workspace.reports 'POST /api/import'
  arena.proc.server -[writes]-> arena.workspace.judgments 'POST /api/adjudicate and /api/rubric'

  // Audit job runner
  arena.proc.jobs -> arena.proc.orchestrator 'asyncio.run(audit_many()) with a progress callback'

  // Orchestrator
  arena.proc.orchestrator -> arena.proc.reader 'list_files, read_file, search_code (at most 6 calls per turn, results cut to 14 kB)'
  arena.proc.orchestrator -> arena.proc.litellm 'await acompletion(model, messages, tools, api_base?)'
  arena.proc.orchestrator -> arena.proc.reportValidator 'final answer: parse_report() then validate_locations()'
  arena.proc.orchestrator -> arena.proc.storage 'load_json, save_json'
  arena.proc.orchestrator -[reads]-> arena.workspace.prompt 'prompt.md becomes the user message'
  arena.proc.orchestrator -[reads]-> arena.workspace.manifest 'commit SHA for audit_metadata'
  arena.proc.orchestrator -[writes]-> arena.workspace.reports 'reports/<model>.json on success'
  arena.proc.orchestrator -[writes]-> arena.workspace.failures 'failures/<model>.json when a report is rejected'

  // Control Page repository and review history
  arena.proc.localData -> arena.proc.storage 'load_json(), save_json() for settings.json'
  arena.proc.localData -[reads]-> arena.appData.reviews 'list_reviews() reads managed review manifests'
  arena.proc.storage -[reads]-> arena.appData.settings 'load_settings()'
  arena.proc.storage -[writes]-> arena.appData.settings 'save_repository_path()'
  arena.proc.workspaceBuilder -[writes]-> arena.appData.reviews 'initialize_workspace() for a new Control Page review'

  // LiteLLM
  arena.proc.litellm -> providers 'one HTTPS request per tool round'
  arena.proc.litellm -[reads]-> apiKeys 'provider key from the environment'

  // Read-only reader
  arena.proc.reader -[reads]-> arena.workspace.snapshot 'only files in the allow-list built at construction'

  // Workspace creation
  arena.proc.workspaceBuilder -> arena.proc.snapshotter 'snapshot_repo()'
  arena.proc.workspaceBuilder -> arena.proc.promptBuilder 'build_prompt(manifest, focus, tree)'
  arena.proc.workspaceBuilder -> arena.proc.reader 'describe(): file tree for the prompt'
  arena.proc.workspaceBuilder -> arena.proc.storage 'save_json(manifest.json)'
  arena.proc.workspaceBuilder -[writes]-> arena.workspace.prompt 'prompt.md'
  arena.proc.snapshotter -[spawns]-> git 'rev-parse, diff --name-only HEAD, ls-files -z'
  arena.proc.snapshotter -[reads]-> targetRepo 'each allowed tracked file, read as bytes'
  arena.proc.snapshotter -[writes]-> arena.workspace.snapshot 'sanitized UTF-8 copy, hashes go to the manifest'
  git -[reads]-> targetRepo 'HEAD, index, working tree status'

  // Storage
  arena.proc.storage -[writes]-> arena.workspace.manifest 'atomic JSON write'
  arena.proc.storage -[writes]-> arena.workspace.reports 'atomic JSON write'
  arena.proc.storage -[writes]-> arena.workspace.judgments 'atomic JSON write'
  arena.proc.storage -[writes]-> arena.workspace.failures 'atomic JSON write'

  // The manual route
  codingAgent -> providers 'its own model calls, outside Arena'
}

deployment {

  you = layer 'You' {
    description 'The reviewer and the two things they operate that are not Arena code: the browser tab and, for manual audits, an IDE or coding agent.'
    metadata {
      criteria 'Clients and actors: the people involved in an audit and the programs they operate directly, such as the browser dashboard and an IDE or coding agent.'
      displayOrder 'declared'
    }

    person = instanceOf reviewer
    dashboard = instanceOf arena.page {
      technology 'Browser · EN / PT-BR'
    }
    ide = instanceOf codingAgent {
      technology 'Option B · optional'
    }
  }

  host = layer 'Host' {
    description 'Your own machine. Nothing in Arena listens on any other interface or runs anywhere else.'
    metadata {
      criteria 'The main process and its modules: the reporeview Python process, the code under src/reporeview_arena, and the library loaded inside that process.'
      displayOrder 'declared'
    }

    app = frame 'reporeview process' {
      description 'The command-line entry points and the loopback dashboard share one code base and one process model.'
      technology 'Python 3.11+'
      metadata {
        criteria 'Modules of src/reporeview_arena that run inside the reporeview process, plus the LiteLLM library it loads in-process.'
        displayOrder 'dependencies'
      }

      cli = instanceOf arena.proc.cli
      server = instanceOf arena.proc.server
      jobs = instanceOf arena.proc.jobs
      orchestrator = instanceOf arena.proc.orchestrator
      reader = instanceOf arena.proc.reader
      snapshotter = instanceOf arena.proc.snapshotter
      workspaceBuilder = instanceOf arena.proc.workspaceBuilder
      promptBuilder = instanceOf arena.proc.promptBuilder
      reportValidator = instanceOf arena.proc.reportValidator
      scorer = instanceOf arena.proc.scorer
      storage = instanceOf arena.proc.storage
      localData = instanceOf arena.proc.localData
      litellm = instanceOf arena.proc.litellm {
        technology 'Optional extra'
      }
    }
  }

  services = layer 'Services' {
    description 'Child processes started on demand. Arena has no daemon, queue or sidecar of its own.'
    metadata {
      criteria 'Other processes and sidecars that the main process starts or talks to on the same machine, which today means only the git subprocess.'
      displayOrder 'declared'
    }

    gitCli = instanceOf git {
      technology 'Subprocess · 15 s timeout'
    }
  }

  stores = layer 'Data' {
    description 'Plain files. There is no database. The Control Page also keeps a per-user repository setting and managed review folders.'
    metadata {
      criteria 'Stores: CLI workspaces, Control Page application data, models.json, the target checkout and provider keys in the environment.'
      displayOrder 'declared'
    }

    workspace = frame 'Arena workspace folder' {
      description 'Everything Arena writes, one folder per arena.'
      technology 'Filesystem'
      metadata {
        criteria 'The six artifacts Arena writes inside one arena folder: manifest, prompt, snapshot, reports, judgments and failures.'
        displayOrder 'declared'
      }

      manifest = instanceOf arena.workspace.manifest
      prompt = instanceOf arena.workspace.prompt
      snapshot = instanceOf arena.workspace.snapshot
      reports = instanceOf arena.workspace.reports
      judgments = instanceOf arena.workspace.judgments
      failures = instanceOf arena.workspace.failures
    }

    managedData = frame 'Control Page application data' {
      description 'OS-standard per-user data directory, separate from workspaces at operator-chosen CLI paths.'
      technology 'Filesystem'
      metadata {
        criteria 'Persistent Control Page data: the selected repository path and UUID-named review workspaces.'
        displayOrder 'declared'
      }

      settings = instanceOf arena.appData.settings
      reviews = instanceOf arena.appData.reviews
    }

    inputs = frame 'Inputs and configuration' {
      description 'Things the operator supplies and Arena only reads.'
      technology 'Filesystem · environment'
      metadata {
        criteria 'Files and settings that Arena only reads: the target Git checkout, models.json and the provider API keys in the process environment.'
        displayOrder 'declared'
      }

      repo = instanceOf targetRepo {
        technology 'Read only'
      }
      config = instanceOf modelsConfig {
        technology 'Gitignored'
      }
      keys = instanceOf apiKeys {
        technology 'Never written by Arena'
      }
    }
  }

  endpoints = layer 'Models' {
    description 'The only network destinations. Source fragments leave the machine here, and only after the reviewer confirms.'
    metadata {
      criteria 'Model endpoints: the LLM provider APIs that LiteLLM sends audit conversations to, whether named in models.example.json or set through api_base.'
      displayOrder 'declared'
    }

    openai = instanceOf providers.openai
    anthropic = instanceOf providers.anthropic
    gemini = instanceOf providers.gemini
    mistral = instanceOf providers.mistral
    xai = instanceOf providers.xai
    openrouter = instanceOf providers.openrouter
    custom = instanceOf providers.custom
  }
}

views {

  view index {
    title 'RepoReview Arena in context'
    description 'One reviewer, one local application, a git subprocess, the files it reads and the model providers it pays for.'

    include *
    autoLayout TopBottom
  }

  view parts of arena {
    title 'Inside the application'
    description 'A browser page and Python process use file-based workspaces plus per-user application data for the Control Page.'

    include *
    autoLayout TopBottom
  }

  view modules of arena.proc {
    title 'Modules of the reporeview process'
    description 'Two entry points (CLI and dashboard server) over one audit engine, a snapshot builder, a report validator, a scorer and a JSON storage layer.'

    include *
    autoLayout TopBottom
  }

  view folder of arena.workspace {
    title 'The arena workspace folder'
    description 'Six artifacts and which module writes or reads each of them.'

    include *
    autoLayout LeftRight
  }

  view managedData of arena.appData {
    title 'Control Page application data'
    description 'The selected repository path and per-repository review history persist in the OS-standard application-data directory.'

    include *
    autoLayout LeftRight
  }

  dynamic view freezeFlow {
    title 'Create an arena'
    description 'reporeview init (the dashboard does the same through POST /api/workspace/init): freeze one commit, record what was kept and skipped, write the prompt.'

    reviewer -> arena.proc.cli 'reporeview init --repo --out --focus'
    arena.proc.cli -> arena.proc.workspaceBuilder 'initialize_workspace()'
    arena.proc.workspaceBuilder -> arena.proc.snapshotter 'snapshot_repo()'
    arena.proc.snapshotter -> git 'rev-parse, diff --name-only HEAD, ls-files -z'
    arena.proc.snapshotter -> targetRepo 'reads each allowed tracked file'
    arena.proc.snapshotter -> arena.workspace.snapshot 'writes the sanitized copy'
    arena.proc.workspaceBuilder -> arena.workspace.manifest 'save_json(manifest.json)'
    arena.proc.workspaceBuilder -> arena.proc.promptBuilder 'build_prompt()'
    arena.proc.workspaceBuilder -> arena.workspace.prompt 'writes prompt.md'

    autoLayout LeftRight
  }

  dynamic view controlFlow {
    title 'Select a repository and create or open a review'
    description 'The Control Page persists the selected checkout and its review history between app sessions.'

    reviewer -> arena.page 'selects a local Git checkout'
    arena.page -> arena.proc.server 'GET /api/status, then POST /api/settings/repository'
    arena.proc.server -> arena.proc.localData 'load settings and save_repository_path()'
    arena.proc.localData -> arena.proc.storage 'load_json() and save_json()'
    arena.proc.storage -> arena.appData.settings 'read or write settings.json'
    arena.page -> arena.proc.server 'GET /api/reviews'
    arena.proc.server -> arena.proc.localData 'list_reviews() for the selected checkout'
    arena.proc.localData -> arena.appData.reviews 'reads managed review manifests'
    reviewer -> arena.page 'creates a review with priorities or opens one from history'
    arena.page -> arena.proc.server 'POST /api/reviews or /api/reviews/open'
    arena.proc.server -> arena.proc.workspaceBuilder 'initialize_workspace() or validate_workspace()'
    arena.proc.workspaceBuilder -> arena.proc.snapshotter 'snapshot_repo() for a new review'
    arena.proc.snapshotter -> git 'rev-parse, diff --name-only HEAD, ls-files -z'
    arena.proc.snapshotter -> targetRepo 'reads allowed tracked files'
    arena.proc.snapshotter -> arena.appData.reviews 'writes snapshot under reviews/<id>/'
    arena.proc.workspaceBuilder -> arena.appData.reviews 'writes manifest and prompt for new review'
    arena.page -> arena.proc.server 'GET /api/data loads the active review'

    autoLayout LeftRight
  }

  dynamic view auditFlow {
    title 'Audit one contestant from the dashboard'
    description 'The only path that sends source to a provider. The CLI run command reaches the orchestrator the same way, without the HTTP and job steps.'

    reviewer -> arena.page 'ticks contestants, authorizes sending, Start audit'
    arena.page -> arena.proc.server 'POST /api/run with X-Arena-Token and confirm_send_code'
    arena.proc.server -> arena.proc.jobs 'one daemon thread, one job at a time'
    arena.proc.jobs -> arena.proc.orchestrator 'asyncio.run(audit_many())'
    arena.proc.orchestrator -> arena.workspace.prompt 'reads prompt.md'
    arena.proc.orchestrator -> arena.proc.litellm 'acompletion(messages, tools)'
    arena.proc.litellm -> providers 'one request per tool round'
    arena.proc.orchestrator -> arena.proc.reader 'list_files, read_file, search_code'
    arena.proc.reader -> arena.workspace.snapshot 'reads approved files only'
    arena.proc.orchestrator -> arena.proc.reportValidator 'parse_report(), validate_locations()'
    arena.proc.orchestrator -> arena.workspace.reports 'reports/<model>.json, or failures/<model>.json if rejected'
    arena.page -> arena.proc.server 'GET /api/status every 1.2 s until the job ends'

    autoLayout LeftRight
  }

  dynamic view importFlow {
    title 'Import a manual report'
    description 'Option B: the same prompt goes to an IDE or coding agent by hand, and its JSON comes back through the same validator as an API report.'

    reviewer -> arena.proc.cli 'reporeview prompt'
    arena.proc.cli -> arena.workspace.prompt 'prints prompt.md'
    reviewer -> codingAgent 'pastes the prompt, collects the JSON report'
    reviewer -> arena.proc.cli 'reporeview import --model --file'
    arena.proc.cli -> arena.proc.reportValidator 'parse_report(), validate_locations()'
    arena.proc.cli -> arena.workspace.reports 'writes reports/<model>.json'

    autoLayout LeftRight
  }

  dynamic view reviewFlow {
    title 'Adjudicate and rank'
    description 'Combined and mode-specific scores are recomputed from reports and judgments on every GET /api/data or /api/status; nothing is cached.'

    reviewer -> arena.page 'sets verdict, severity, issue key and rubric scores'
    arena.page -> arena.proc.server 'POST /api/adjudicate or /api/rubric'
    arena.proc.server -> arena.workspace.judgments 'judgments/<model>.json'
    arena.page -> arena.proc.server 'GET /api/data'
    arena.proc.server -> arena.workspace.reports 'reads reports/*.json and judgments/*.json'
    arena.proc.server -> arena.proc.scorer 'leaderboard() and leaderboards()'
    arena.proc.server -> arena.page 'reports, judgments, combined and mode-specific leaderboards'

    autoLayout LeftRight
  }

  deployment view deployment {
    title 'Deployment'
    description 'Everything runs on the reviewer machine. The only network traffic is LiteLLM to the model providers; the dashboard listens on 127.0.0.1 only.'

    include you.*, host.*, host.app.*, services.*, stores.*, stores.workspace.*, stores.managedData.*, stores.inputs.*, endpoints.*
    autoLayout TopBottom
  }
}
